def ensure_workshop() -> None:
    WORKSHOP_DIR.mkdir(parents=True, exist_ok=True)


def list_cases() -> List[Path]:
    if not WORKSHOP_DIR.exists():
        return []
    cases = [p for p in WORKSHOP_DIR.iterdir() if p.is_dir() and not p.name.startswith(".")]
    # Sort by modified time (desc)
    cases.sort(key=lambda p: p.stat().st_mtime, reverse=True)
    return cases


def fmt_mtime(p: Path) -> str:
    dt = datetime.fromtimestamp(p.stat().st_mtime)
    # Example: "February 3 09:12"
    return f"{dt:%B} {dt.day} {dt:%H:%M}"


def check_mcp_connected() -> bool:
    """
    Best-effort heuristic: confirms the Docker MCP Gateway CLI is present
    and responding (`docker mcp --help`). It does not validate that the
    gateway is actively serving the Anakrisis server.
    """
    if not shutil.which("docker"):
        return False
    # docker mcp is a subcommand, so `shutil.which("docker mcp")` isn't a thing.
    # We just attempt a harmless command.
    code, _out = run_capture(["docker", "mcp", "--help"])
    return code == 0


def status_checks(repo_dir: Path) -> None:
    console.print(Rule(style=MUTED))
    console.print(Text("Checking", style=MUTED))

    # (name, check_fn, exit_code_or_None, fix_hint). A None exit code means the
    # check is advisory: it only applies to the Docker MCP Gateway deployment,
    # so a direct stdio setup (.mcp.json) still works without it.
    checks = [
        ("Docker", lambda: run_ok(["docker", "info"]), None,
         "Note: only needed for the Docker MCP Gateway deployment. Start Docker Desktop (macOS/Windows) or the docker daemon (Linux)."),

        ("Claude CLI", lambda: shutil.which("claude") is not None, EXIT_CLAUDE,
         "Fix: install the Claude Code CLI and ensure `claude` is available on PATH."),

        ("MCP Gateway", lambda: check_mcp_connected(), None,
         "Note: only needed for the Docker MCP Gateway deployment: `docker mcp --help`."),

        ("Protocol Marker", lambda: protocol_present(repo_dir), EXIT_PROTOCOL,
         f"Fix: run the launcher from a project root containing a file named: {PROTOCOL_MARKER}"),
    ]

    for name, fn, code, fix in checks:
        with console.status(f"{name} …", spinner="dots"):
            ok = False
            try:
                ok = bool(fn())
            except Exception:
                ok = False

        if not ok:
            if code is None:
                console.print(Text(f"⚠ {name} (skipped)", style="yellow"))
                console.print(Text(fix, style=MUTED))
                continue
            console.print(Text(f"✗ {name}", style="bold red"))
            console.print(Text(fix, style=MUTED))
            sys.exit(code)

        console.print(Text(f"✓ {name}", style="green"))

    console.print(Rule(style=MUTED))


def print_cases_section() -> None:
    ensure_workshop()
    cases = list_cases()
    console.print(
        Text(f"Cases on disk: {len(cases)}", style=MUTED)
        + Text(" × ", style=MUTED)
        + Text(f"Workshop: {WORKSHOP_DIR}", style=MUTED)
    )

    console.print(Text("Recent cases:", style=MUTED))
    if not cases:
        console.print(Text("   (none yet) — create a folder under the workshop directory.", style=MUTED))
        return

    for p in cases[:RECENT_CASES_N]:
        line = Text("   ")
        line.append(fmt_mtime(p), style=MUTED)
        line.append("    ")
        line.append(p.name, style=CASE_COLOR)
        console.print(line)


def main() -> None:
    clear_screen()
    banner()

    repo_dir = Path(__file__).resolve().parent

    # Directory check: launcher must live in project root with at least N markers
    if not has_markers(repo_dir, REPO_MARKERS, require_at_least=2):
        console.print(Text("✗ This launcher must be run from the Anakrisis project root.", style="bold red"))
        console.print(Text(f"Detected launcher location: {repo_dir}", style=MUTED))
        console.print(Text("Expected to find at least 2 of these files in that folder:", style=MUTED))
        for m in REPO_MARKERS:
            console.print(Text(f"  - {m}", style=MUTED))
        sys.exit(EXIT_BAD_DIR)

    # Checks (spinners → checkmarks)
    status_checks(repo_dir)

    # Cases
    print_cases_section()
    console.print()

    console.print(Text("Starting The Anakrisis Protocol...", style="bold"))
    console.print(Text("Interact in plain language — no special commands required.", style=MUTED))
    console.print(Text('Example: "Plan an ethical OSINT investigation."', style=MUTED))
    console.print()

    # Launch the MCP client CLI from the project root
    os.chdir(repo_dir)

    env = os.environ.copy()

    # Clear local endpoint overrides so the CLI uses its default config.
    for var in ("ANTHROPIC_BASE_URL", "ANTHROPIC_AUTH_TOKEN"):
        if env.pop(var, None) is not None:
            console.print(Text(f"Note: ignoring {var} override for this session.", style=MUTED))

    os.execvpe("claude", ["claude"], env)

if __name__ == "__main__":
    main()
