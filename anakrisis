#!/usr/bin/env python3
import os
import sys
import shutil
import subprocess
from pathlib import Path
from datetime import datetime
from typing import Iterable, List, Optional, Tuple

# --- Optional dependency (Rich). Hard-fail with a clear message if missing.
try:
    from rich.console import Console
    from rich.text import Text
    from rich.rule import Rule
    from rich.status import Status
except Exception:
    print("This launcher requires the 'rich' package.")
    print("Install it with: python3 -m pip install rich")
    sys.exit(10)

# -----------------------------
# Config / project markers
# -----------------------------
# Files expected in the project root; used to confirm the launcher is
# running from a real Anakrisis checkout.
REPO_MARKERS = [
    "Dockerfile",
    "anakrisis.py",          # case-insensitive match handled below
    "doctrine",              # doctrine YAML directory
]

# Protocol marker: a file named "anakrisis" in the project root positively
# identifies an Anakrisis checkout. The launcher itself serves as the marker.
PROTOCOL_MARKER = "anakrisis"

# Cases directory (workshop)
WORKSHOP_DIR = Path.home() / "anakrisis" / "cases"

# How many recent cases to show
RECENT_CASES_N = 8

# Exit codes
EXIT_BAD_DIR = 2
EXIT_DOCKER = 3
EXIT_CLAUDE = 4
EXIT_MCP = 6
EXIT_PROTOCOL = 7

# UI
ORANGE = "rgb(255,115,0)"        # neon orange
CASE_COLOR = "rgb(145,195,100)"  # light matcha green
MUTED = "grey70"

console = Console(force_terminal=True)


def clear_screen() -> None:
    os.system("cls" if os.name == "nt" else "clear")


def run_ok(cmd: List[str]) -> bool:
    try:
        subprocess.check_output(cmd, stderr=subprocess.DEVNULL)
        return True
    except Exception:
        return False


def run_capture(cmd: List[str]) -> Tuple[int, str]:
    try:
        out = subprocess.check_output(cmd, stderr=subprocess.STDOUT, text=True)
        return (0, out)
    except subprocess.CalledProcessError as e:
        return (e.returncode or 1, (e.output or ""))
    except Exception as e:
        return (1, str(e))


def listdir_lower(p: Path) -> set:
    try:
        return {x.name.lower() for x in p.iterdir()}
    except Exception:
        return set()


def has_markers(repo_dir: Path, markers: Iterable[str], require_at_least: int = 2) -> bool:
    names = listdir_lower(repo_dir)
    required = {m.lower() for m in markers}
    present = required.intersection(names)
    return len(present) >= require_at_least


def protocol_present(repo_dir: Path) -> bool:
    names = listdir_lower(repo_dir)
    return PROTOCOL_MARKER.lower() in names


